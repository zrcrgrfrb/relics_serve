# 部署到服务器时，复制为 config/application-prod.yml，然后使用 prod 配置启动：
# java -jar relics_serve.jar --spring.profiles.active=prod

server:
  port: 8082

app:
  # 后端公网地址，用于生成上传图片的访问 URL。
  public-base-url: https://api.example.com
  upload:
    # 服务器上的上传目录建议使用绝对路径，避免应用重启或切换目录后找不到图片。
    dir: /opt/reslic/uploads
  jwt:
    # JWT 密钥，正式部署必须替换为至少 32 字节的强密钥。
    secret: change-this-to-a-strong-secret-at-least-32-bytes
    expiration-ms: 7200000
    issuer: reslic-system
  cors:
    # 允许访问后端接口的前端域名。
    allowed-origins: https://www.example.com

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/relic_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: relic_user
    password: change-this-db-password
