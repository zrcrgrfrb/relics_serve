# 可选的环境变量部署模板。
# 如果希望服务器上只改一个 env 文件，可以复制为 deploy.env，
# 并在启动 Spring Boot jar 前加载这些变量。

RESLIC_SERVER_PORT=8082

RESLIC_DB_HOST=127.0.0.1
RESLIC_DB_PORT=3306
RESLIC_DB_NAME=relic_db
RESLIC_DB_USERNAME=relic_user
RESLIC_DB_PASSWORD=change-this-db-password

RESLIC_PUBLIC_BASE_URL=https://api.example.com
RESLIC_UPLOAD_DIR=/opt/reslic/uploads
RESLIC_CORS_ALLOWED_ORIGINS=https://www.example.com

RESLIC_JWT_SECRET=change-this-to-a-strong-secret-at-least-32-bytes
RESLIC_JWT_EXPIRATION_MS=7200000
RESLIC_JWT_ISSUER=reslic-system
